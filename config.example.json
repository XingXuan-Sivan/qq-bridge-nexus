{
  "dsh": {
    "baseUrl": "",
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "reasoningEffort": "max",
    "authToken": "",
    "authHeader": "authorization",
    "authPrefix": "Bearer",
    "allowRemote": false
  },
  "role": {
    "saveApply": "nextWake"
  },
  "promptBlocks": {
    "core-persona": {
      "maxChars": 8000
    },
    "core-stickers": {
      "enabled": true
    },
    "core-memory": {
      "enabled": true
    },
    "core-skills": {
      "enabled": true
    }
  },
  "memory": {
    "inject": {
      "provider": "local-digest",
      "maxChars": 2400,
      "timeoutMs": 900,
      "cacheTtlMs": 60000
    },
    "providers": {
      "local-digest": {
        "enabled": true
      },
      "soulkit": {
        "enabled": false,
        "baseUrl": "http://127.0.0.1:3110",
        "timeoutMs": 900,
        "maxChars": 1200
      }
    },
    "tools": {
      "recall": true,
      "note": false
    },
    "handover": {
      "enabled": true
    },
    "ingest": {
      "enabled": false,
      "baseUrl": "http://127.0.0.1:3110",
      "maxQueue": 200,
      "batchSize": 40,
      "flushIntervalMs": 1500,
      "timeoutMs": 5000
    }
  },
  "skills": {
    "enabled": true,
    "maxEntries": 12,
    "maxChars": 1200,
    "maxDescriptionChars": 40,
    "dirs": []
  },
  "platform": {
    "id": "qq"
  },
  "runtime": {
    "defaultPlan": "social-v2"
  },
  "snowluma": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "followDiscoveredEndpoint": true,
    "viaPlatform": false,
    "silenceWarnMs": 600000,
    "launcherPath": "",
    "homeDir": ""
  },
  "ownerQQ": null,
  "sessionCwd": "",
  "agentPreset": "qq-chat",
  "workspaceTitle": "QQ 聊天",
  "allow": {
    "private": [],
    "groups": []
  },
  "deny": {
    "private": [],
    "groups": []
  },
  "allowAllWhenEmpty": false,
  "ackMessage": "",
  "sendDelayMs": 300,
  "questionTimeoutMs": 300000,
  "consolePort": 3100,
  "consoleToken": "",
  "pricing": {
    "models": {
      "my-relay-model": {
        "label": "我的中转模型",
        "off": {
          "cacheHit": 0.5,
          "cacheMiss": 3,
          "output": 9
        }
      }
    }
  },
  "security": {
    "interceptNotify": true
  },
  "continuity": {
    "enabled": true,
    "sharePolicy": "identity",
    "injectPeople": true,
    "injectMaxPeople": 8,
    "injectMaxChars": 1500,
    "reconcileOnConnect": true,
    "joinEvents": {
      "wake": true,
      "wakeOn": [
        "stranger",
        "knownElsewhere",
        "returning"
      ]
    },
    "leaveEvents": {
      "wake": false
    },
    "groups": {
      "10001": {
        "label": "示例游戏群",
        "sharePolicy": "identity",
        "recordable": true
      },
      "20002": {
        "label": "",
        "sharePolicy": "none",
        "recordable": true
      }
    }
  },
  "admin": {
    "enabled": true,
    "naturalLanguage": true,
    "safeMode": "reserved2",
    "defaultAgentLevel": "L1",
    "confirmCodeDigits": 4,
    "requestTtlMs": 120000,
    "maxConfirmAttempts": 3,
    "maxPendingRequests": 3,
    "idleTimeoutMs": 1800000,
    "maxElevatedMs": {
      "L1": 14400000,
      "L2": 7200000,
      "L3": 3600000
    },
    "totpMaxFailures": 5,
    "totpLockMs": 900000,
    "allowL3": true,
    "externalEscalation": "revert",
    "showPrivateNotes": false,
    "pinChatReadOnly": true,
    "approvalArgsMaxChars": 600,
    "consoleEscalationCooldownMs": 600000,
    "allowCustomAgentPreset": false
  },
  "crossGroup": {
    "enabled": false,
    "links": [
      {
        "from": "10001",
        "to": "20002",
        "allow": [
          "activity"
        ]
      }
    ]
  },
  "slang": {
    "enabled": true,
    "extractMinMessages": 10,
    "extractCooldownMs": 300000,
    "inferenceThresholds": [
      2,
      4,
      8
    ],
    "injectMax": 8,
    "learnerPreset": "qq-chat",
    "workspaceTitle": "QQ 黑话学习",
    "autoResearch": true
  },
  "webSearch": {
    "provider": "auto",
    "apiKey": "",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseURL": "",
    "model": "deepseek-v4-flash",
    "maxUses": 5,
    "maxTokens": 4096,
    "maxResults": 8,
    "timeoutMs": 35000
  },
  "compact": {
    "enabled": false,
    "thresholdTokens": 80000,
    "cooldownMinutes": 120,
    "idleDelayMs": 20000
  },
  "voice": {
    "enabled": false,
    "dir": "audio",
    "maxSeconds": 300,
    "maxBytes": 20971520,
    "maxPerMinute": 2,
    "maxPerHour": 10,
    "allowAbsolutePath": false,
    "defaultVolume": 1,
    "loudness": "normal",
    "ffmpegPath": "",
    "autoReadback": true
  },
  "media": {
    "maxBytes": 8388608,
    "maxPixels": 64000000,
    "maxCount": 5
  },
  "limits": {
    "send": {
      "maxSendPerMinute": 10,
      "maxSendPerHour": 120
    },
    "initialPromptMaxChars": 2000
  },
  "permission": {
    "default": "read-only",
    "allowFull": false,
    "fullTtlMin": 30
  }
}
