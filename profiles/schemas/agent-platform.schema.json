{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "label",
    "tools",
    "capabilities",
    "agents"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "string"
    }
  }
}
