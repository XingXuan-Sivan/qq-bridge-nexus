{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "label",
    "tools"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "tools": {
      "type": "object",
      "required": [
        "platform",
        "agent",
        "mcp",
        "skills"
      ],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "mcp": {
          "type": "array"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
