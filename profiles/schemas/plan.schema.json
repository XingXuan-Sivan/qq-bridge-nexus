{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "label",
    "platform",
    "agentPlatform",
    "agent",
    "behavior",
    "capability",
    "audience"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "builtin": {
      "type": "boolean"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "agentPlatform": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "enum": [
        "owner",
        "access"
      ]
    }
  }
}
