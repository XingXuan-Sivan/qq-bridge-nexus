{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "label",
    "behavior",
    "capability",
    "audience"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "builtin": {
      "type": "boolean"
    },
    "agentPlatform": {
      "type": "string",
      "minLength": 1,
      "description": "auto = 跟随全局默认执行体；写具体 id 表示这套方案必须跑在该执行体上。"
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "enum": [
        "owner",
        "access"
      ]
    }
  }
}
