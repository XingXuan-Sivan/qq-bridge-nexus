{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "label",
    "tools",
    "prompt",
    "behaviors"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "object",
      "required": [
        "active",
        "default"
      ],
      "properties": {
        "active": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "behaviors": {
      "type": "object",
      "required": [
        "dir",
        "kinds"
      ],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
